    },
    {
      "id": "voices-bassoon",
      "dimension": "counterpoint",
      "title": "旋律从背景中显出",
      "summary": "低音巴松的长句成为前景，低弦保持持续音与流动背景；先分清旋律和支撑层。",
      "detail": "沿低音巴松句子的延续聆听，再与低弦的持续／分解层比较。声部职责不同，不按同时演奏的乐器数计算复调声部。",
      "score_spans": [
