  "readings": [
    {
      "id": "voices-opening",
      "dimension": "counterpoint",
      "title": "持续层与流动层",
      "summary": "大提琴长音与低音提琴六连音分担持续和流动；节奏分层不等于多条独立旋律。",
      "detail": "大提琴两层持续，低音提琴活动层使用同一四度骨架。\n持续音与六连音具有节奏差异，但活动层主要展开背景音集；本窗口不支持把各分部称为独立模仿声部。\n保留持续层、运动层的分工，避免把“多件乐器同时演奏”直接算作严格对位。",
      "score_spans": [
        {
          "precision": "page_range",
          "pdf_page_start": 1,
          "pdf_page_end": 1,
          "region_ids": []
        }
      ],
